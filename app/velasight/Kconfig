config LVX_USE_DEMO_CONTEST2026_264_VELASIGHT
	bool "VelaSight dual-screen UI"
	default n
	depends on VIDEO_FB
	depends on VIDEO
	depends on ARCH_BUTTONS
	depends on NET_TCP && NET_TCPBACKLOG
	depends on NET_IPv4 && NET_UDP && NETUTILS_DHCPC
	depends on ARCH_CHIP_BK7258 && BK7258_WIFI
	depends on BK7258_SDIO && BK7258_SDNAND_AUTOMOUNT && FS_FAT
	depends on EXAMPLES_AI_AGENT_VELA
	select GRAPHICS_LVGL
	select WIRELESS_WAPI
	select NETUTILS_DHCPD
	select SCHED_WAITPID
	select LVX_USE_DEMO_CONTEST2026_264_PROVISION_WEB
	---help---
		First-stage VelaSight UI for the dual GC9D01 framebuffer panels.
		Depends on EXAMPLES_AI_AGENT_VELA because vs_voice.c links directly
		against packages/ai_agent's LLM proxy, router and Volcengine voice
		backends (see vs_voice.c's header comment for why it drives those
		one layer below ai_agent's own voice_channel.c state machine).

config VS_INPUT_POLL_MS
	int "VelaSight input polling interval (ms)"
	default 5
	range 5 100
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT

