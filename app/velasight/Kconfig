config VS_PHOTO_WIDTH
	int "VelaSight still capture width"
	default 480
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT
	---help---
		Must be one of the GC2145 driver's fixed modes: 480x480, 640x480 or
		864x480 (bk7258_gc2145_find_mode() is an exact match, not
		nearest-fit).

config VS_PHOTO_HEIGHT
	int "VelaSight still capture height"
	default 480
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT

config VS_HISTORY_MAX_RECORDS
	int "VelaSight history in-memory index capacity (records)"
	default 64
	range 8 256
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT
	---help---
		Bounds both the in-memory index array and how many records
		vs_history_open() will load from SD-NAND at startup.
