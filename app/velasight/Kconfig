config LVX_USE_DEMO_CONTEST2026_264_VELASIGHT
	bool "VelaSight dual-screen UI"
	default n
	depends on VIDEO_FB
	depends on ARCH_BUTTONS
	depends on NET_TCP && NET_TCPBACKLOG
	depends on NET_IPv4 && NET_UDP && NETUTILS_DHCPC
	depends on ARCH_CHIP_BK7258 && BK7258_WIFI
	depends on BK7258_SDIO && BK7258_SDNAND_AUTOMOUNT && FS_FAT
	select GRAPHICS_LVGL
	select WIRELESS_WAPI
	select NETUTILS_DHCPD
	select SCHED_WAITPID
	select LVX_USE_DEMO_CONTEST2026_264_PROVISION_WEB
	---help---
		First-stage VelaSight UI for the dual GC9D01 framebuffer panels.

config VS_INPUT_POLL_MS
	int "VelaSight input polling interval (ms)"
	default 10
	range 5 100
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT

config VS_SHORT_PRESS_MIN_MS
	int "VelaSight short press minimum (ms)"
	default 80
	range 10 1000
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT

config VS_SHORT_PRESS_MAX_MS
	int "VelaSight short press maximum (ms)"
	default 500
	range 100 1900
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT

config VS_LONG_PRESS_MS
	int "VelaSight long press duration (ms)"
 default 2000
	range 1000 10000
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT

config VS_COMBO_PRESS_MS
	int "VelaSight combo long press duration (ms)"
 default 2000
	range 1000 10000
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT

config VS_AP_RANDOM_PASSWORD
	bool "Generate a random eight-character AP password"
	default n
	depends on LVX_USE_DEMO_CONTEST2026_264_VELASIGHT
	---help---
		Generate a new eight-character alphanumeric password on every AP start.
		Disabled by default while AP provisioning is in testing.

