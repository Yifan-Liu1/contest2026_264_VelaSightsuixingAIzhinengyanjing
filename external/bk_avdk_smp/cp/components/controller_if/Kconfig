menu "Controller IF"
	config CTRL_IF_TP
		bool "Controller Interface Throughput debug"
		default n
	config CONTROLLER_RX_DIRECT_PSH
		bool "Controller RX Buf Directly push to AP"
		default y
	config WIFI_VNET_AP_IPV4
		bool "Application core owns VNET IPv4"
		depends on WIFI_VNET_CONTROLLER && CONTROLLER_RX_DIRECT_PSH
		default n
		help
		  Forward STA ARP and IPv4 traffic to the application core. The
		  controller retains radio, association, security and EAPOL handling.
	config WIFI_VNET_OPENVELA_SOFTAP_IPV4
		bool "OpenVela owns SoftAP VNET IPv4"
		depends on WIFI_VNET_CONTROLLER && CONTROLLER_RX_DIRECT_PSH
		default n
		help
		  Forward ordinary SoftAP ARP and IPv4 traffic to the application
		  core. EAPOL, hostapd, radio and station association remain on the
		  controller core.
	config CONTROLLER_WAR
		bool "Controller RX Buf Directly push to AP"
		default y
	config CONTROLLER_DEBUG
		bool "Controller Debug"
		default n
	config CONTROLLER_AP_BUFFER_COPY
		bool "Controller AP buffer copy to CP buffer when AP use PSRAM instead of SRAM"
		default n
endmenu
