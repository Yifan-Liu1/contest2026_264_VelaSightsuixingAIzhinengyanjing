+    if (llm_host_wants_thinking_off(llm_host)) {
+        cJSON* thinking = cJSON_CreateObject();
+
+        if (thinking) {
+            cJSON_AddStringToObject(thinking, "type", "disabled");
+            cJSON_AddItemToObject(body, "thinking", thinking);
+        }
+    }
+
+    /* JSON mode.  The idle assistant's system prompt defines a strict
+     * answer/display_text/should_speak object and nothing else calls
+     * llm_chat(), so asking the backend to guarantee syntactic JSON here turns
+     * the occasional non-JSON reply -- which reached the screen as "返回数据为空
+     * 或格式错误" -- into a parse that succeeds.  The field is OpenAI-standard,
+     * so it is gated on the compatible hosts rather than on MiMo alone.
+     */
+
+    if (is_openai_compat_host(llm_host)) {
+        cJSON* rf = cJSON_CreateObject();
+
+        if (rf) {
+            cJSON_AddStringToObject(rf, "type", "json_object");
+            cJSON_AddItemToObject(body, "response_format", rf);
+        }
+    }
+
     cJSON* messages = cJSON_Parse(messages_json);
     if (!messages)
         messages = cJSON_CreateArray();
@@ -715,6 +756,15 @@ int llm_chat_tools(const char* system_prompt, cJSON* messages,
             AGENT_LLM_MAX_TOKENS);
     }

+    if (llm_host_wants_thinking_off(llm_host)) {
