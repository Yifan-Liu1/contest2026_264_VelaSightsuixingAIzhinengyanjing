--- a/src/llm/llm_proxy.c
+++ b/src/llm/llm_proxy.c
@@ -62,6 +62,21 @@ bool is_openai_compat_host(const char* host)
 }


+/* MiMo's deep-thinking switch.  Narrower than is_openai_compat_host() on
+ * purpose: "thinking" is not an OpenAI-standard field, and the other
+ * OpenAI-compatible providers behind that helper have no reason to see it.
+ *
+ * mimo-v2.5 and mimo-v2.5-pro think by default, emitting a reasoning_content
+ * chain of thought ahead of the answer.  Nothing here reads that field, and
+ * max_completion_tokens bounds thinking and answer together, so leaving it on
+ * spends response time producing output that is discarded and squeezes the room
+ * left for the reply.  See the provider's deep-thinking documentation.
+ */
+bool llm_host_wants_thinking_off(const char* host)
+{
+    return strstr(host, "xiaomimimo.com") != NULL;
+}
