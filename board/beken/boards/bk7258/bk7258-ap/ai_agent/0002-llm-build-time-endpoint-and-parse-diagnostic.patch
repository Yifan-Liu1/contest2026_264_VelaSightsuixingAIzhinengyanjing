 #ifndef AGENT_SECRET_MODEL
 #define AGENT_SECRET_MODEL ""
 #endif
+#ifndef AGENT_SECRET_LLM_HOST
+#define AGENT_SECRET_LLM_HOST ""
+#endif
+#ifndef AGENT_SECRET_LLM_PATH
+#define AGENT_SECRET_LLM_PATH ""
