if ARCH_BOARD_CUSTOM

config ARCH_BOARD_BK7258_AP
	bool "BK7258 AP board"
	default y
	select ARCH_HAVE_BUTTONS
	select ARCH_HAVE_LEDS

config BK7258_MB_UART0_CONSOLE
	bool "Use CP UART0 through Mailbox V2 for the AP console"
	default y
	depends on SERIAL
	select BK7258_MBOX_V2
	select OTHER_UART_SERIALDRIVER
	select SERIAL_IFLOWCONTROL
	select SERIAL_IFLOWCONTROL_WATERMARKS

config BK7258_GC9D01_FB
	bool "GC9D01 panel framebuffer (/dev/fb0)"
	default n
	depends on VIDEO_FB
	select FB_UPDATE
	help
		Register the 160x160 RGB565 GC9D01 round panel as /dev/fb0, driven
		over QSPI1.  FB_UPDATE is required, not optional: the panel has its
		own GRAM and is written over a serial bus, so nothing reaches the
		glass until updatearea() pushes the framebuffer.  FB_UPDATE has no
		prompt of its own in drivers/video/Kconfig and can only be enabled
		by a select, which is why this option exists.

config BK7258_POWER_KEY_MOTOR
	bool "Vibrate while the power key is pressed"
	default n
	depends on ARCH_BUTTONS && PWM
	help
		Poll the active-low GPIO12 power key using the Beken 5 ms/6 sample
		debounce timing. Drive the vibration motor at 1 kHz and 70 percent
		duty while the key is held, and stop it when the key is released.

config BK7258_BT_GATT_TEST
	bool "BK7258 Bluetooth GATT acceptance fixture"
	default n
	depends on BK7258_BLUETOOTH && !BK7258_BT_RAW_SELFTEST
	help
		Register a test-only GATT service with read/write and notification
		characteristics. Keep this disabled in production images.

endif
