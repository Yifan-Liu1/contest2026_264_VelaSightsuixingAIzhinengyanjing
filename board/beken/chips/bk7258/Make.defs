# SPDX-License-Identifier: Apache-2.0

include armv8-m/Make.defs

LDFLAGS += --entry=__start --build-id=none

CHIP_CSRCS = bk7258_start.c
CHIP_CSRCS += bk7258_vectors.c
CHIP_CSRCS += bk7258_irq.c
CHIP_CSRCS += bk7258_timerisr.c
CHIP_CSRCS += bk7258_gpio.c
CHIP_CSRCS += bk7258_ldo33.c
CHIP_CSRCS += bk7258_pwm.c
CHIP_CSRCS += bk7258_lowputc.c
CHIP_CSRCS += bk7258_syslog.c
CHIP_CSRCS += bk7258_serial.c
CHIP_CSRCS += bk7258_mbox0.c
CHIP_CSRCS += bk7258_mailbox_channel.c
CHIP_CSRCS += bk7258_ipc_heartbeat.c
CHIP_CSRCS += bk7258_wifi.c
CHIP_CSRCS += bk7258_mb_uart.c
CHIP_CSRCS += bk7258_pm_pwc.c
CHIP_CSRCS += bk7258_psram.c
CHIP_CSRCS += bk7258_allocateheap.c
CHIP_CSRCS += bk7258_qspi.c
CHIP_CSRCS += bk7258_dma.c
CHIP_CSRCS += bk7258_i2c_sim.c
CHIP_CSRCS += bk7258_gc2145_i2c_bitbang.c
CHIP_CSRCS += bk7258_yuv_buf.c
CHIP_CSRCS += bk7258_jpeg_enc.c
CHIP_CSRCS += bk7258_camera_imgdata.c
CHIP_CSRCS += bk7258_aud.c
CHIP_CSRCS += bk7258_cpuindex.c
CHIP_CSRCS += bk7258_idle.c
CHIP_CSRCS += bk7258_reset.c

ifeq ($(CONFIG_BK7258_BLUETOOTH),y)
CHIP_CSRCS += bk7258_bt_transport.c
CHIP_CSRCS += bk7258_bt_driver.c

ifeq ($(CONFIG_BK7258_BT_RAW_SELFTEST),y)
CHIP_CSRCS += bk7258_bt_selftest.c
endif
endif

ARCHCPUFLAGS += -mcpu=cortex-m33+nodsp -mthumb
ARCHCPUFLAGS += -mfpu=fpv5-sp-d16 -mfloat-abi=hard -mcmse
ARCHINCLUDES += ${shell $(INCDIR) $(INCDIROPT) "$(CC)" $(CHIP_DIR)}
ARCHINCLUDES += ${shell $(INCDIR) $(INCDIROPT) "$(CC)" $(CHIP_DIR)/include}
ARCHINCLUDES += ${shell $(INCDIR) $(INCDIROPT) "$(CC)" $(CHIP_DIR)/hardware}

CFLAGS += -I$(TOPDIR)/arch/arm/src/chip/include
CFLAGS += -I$(TOPDIR)/arch/arm/src/chip/hardware

BK7258_SWAP_CHECK := $(shell sh $(CHIP_DIR)/check_swap_layout.sh || echo failed)
ifneq ($(BK7258_SWAP_CHECK),)
$(error BK7258 app_ab SWAP layout validation failed)
endif
