{"schema_version": "1.0", "session_id": "sess_b511c05d-7162-44af-bc58-f3ba3c6d682d", "team_id": "contest2026_264_VelaSightsuixingAIzhinengyanjing", "github_login": "Yifan-Liu1", "tool": "kiro", "seq": 10674, "ts": "2026-09-09T11:22:03.142Z", "role": "tool", "tool_name": "fs_write", "tool_call_id": "toolu_bdrk_01MN1nnkKhiwYDGBpo4t53CN", "input": {"path": "/home/mi/convwork/build_showcase_docx.py", "text": "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"生成 VelaSight 项目展示 docx：聚焦两个核心功能（闲时语音助手 / 社交情绪识别），\n供答辩、汇报使用。当前展示载体是 BK7258 开发板，不是眼镜成品，全文措辞据此调整。\"\"\"\n\nfrom docx import Document\nfrom docx.shared import Pt, Cm, RGBColor\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml.ns import qn\nfrom docx.oxml import OxmlElement\n\nDOC = Document()\n\n# ---------- 基础样式 ----------\nstyle = DOC.styles['Normal']\nstyle.font.name = '微软雅黑'\nstyle.font.size = Pt(11)\nstyle.element.rPr.rFonts.set(qn('w:eastAsia'), '微软雅黑')\n\nfor name, size, bold in [('Heading 1', 20, True), ('Heading 2', 16, True),\n                          ('Heading 3', 13, True)]:\n    s = DOC.styles[name]\n    s.font.name = '微软雅黑'\n    s.font.size = Pt(size)\n    s.font.bold = bold\n    s.font.color.rgb = RGBColor(0x1a, 0x3c, 0x6e)\n    s.element.rPr.rFonts.set(qn('w:eastAsia'), '微软雅黑')\n\n\ndef set_cell_shading(cell, hex_color):\n    tcPr = cell._tc.get_or_add_tcPr()\n    shd = OxmlElement('w:shd')\n    shd.set(qn('w:fill'), hex_color)\n    tcPr.append(shd)\n\n\ndef add_table(headers, rows, widths=None):\n    t = DOC.add_table(rows=1, cols=len(headers))\n    t.style = 'Table Grid'\n    t.alignment = WD_TABLE_ALIGNMENT.CENTER\n    hdr = t.rows[0].cells\n    for i, h in enumerate(headers):\n        hdr[i].text = h\n        set_cell_shading(hdr[i], '1a3c6e')\n        for p in hdr[i].paragraphs:\n            for r in p.runs:\n                r.font.color.rgb = RGBColor(0xff, 0xff, 0xff)\n                r.font.bold = True\n                r.font.size = Pt(10)\n    for row in rows:\n        cells = t.add_row().cells\n        for i, val in enumerate(row):\n            cells[i].text = str(val)\n            for p in cells[i].paragraphs:\n                for r in p.runs:\n                    r.font.size = Pt(10)\n    if widths:\n        for row in t.rows:\n            for i, w in enumerate(widths):\n                row.cells[i].width = Cm(w)\n    DOC.add_paragraph()\n    return t\n\n\ndef add_callout(text, color='FFF3CD'):\n    p = DOC.add_paragraph()\n    p.paragraph_format.space_before = Pt(4)\n    p.paragraph_format.space_after = Pt(8)\n    run = p.add_run(text)\n    run.font.size = Pt(10.5)\n    run.italic = True\n    pPr = p._p.get_or_add_pPr()\n    shd = OxmlElement('w:shd')\n    shd.set(qn('w:fill'), color)\n    pPr.append(shd)\n    return p\n\n\n# ======================================================================\n# 封面\n# ======================================================================\ntitle = DOC.add_paragraph()\ntitle.alignment = WD_ALIGN_PARAGRAPH.CENTER\nr = title.add_run('VelaSight 随行 AI 眼镜项目')\nr.font.size = Pt(30)\nr.font.bold = True\nr.font.color.rgb = RGBColor(0x1a, 0x3c, 0x6e)\n\nsub = DOC.add_paragraph()\nsub.alignment = WD_ALIGN_PARAGRAPH.CENTER\nr = sub.add_run('两大核心功能展示报告（开发板验证阶段）')\nr.font.size = Pt(16)\nr.font.color.rgb = RGBColor(0x55, 0x55, 0x55)\n\nDOC.add_paragraph()\ninfo = DOC.add_paragraph()\ninfo.alignment = WD_ALIGN_PARAGRAPH.CENTER\nr = info.add_run(\n    '硬件平台：BK7258（Cortex-M33，480 MHz） / 系统：OpenVela (NuttX)\\n'\n    '仓库分支：dev-ai-contest-2026\\n'\n    '当前展示载体为功能验证开发板，非眼镜成品外形；产品最终形态计划做成眼镜\\n'\n    '本报告基于当前代码与 git 提交记录逐条核实生成，不含未验证推断'\n)\nr.font.size = Pt(11)\nr.font.color.rgb = RGBColor(0x77, 0x77, 0x77)\n\nDOC.add_page_break()\n\n# ======================================================================\n# 一、项目总览\n# ======================================================================\nDOC.add_heading('一、项目总览', level=1)\n\nDOC.add_paragraph(\n    'VelaSight 是一个基于 BK7258 芯片、运行 OpenVela（NuttX 内核）系统的随行 AI'\n    '项目，目标产品形态是一副智能眼镜。当前阶段的软硬件能力在 BK7258 开发板上完成'\n    '验证，尚未装配为眼镜外形，本报告与配套演示均以\"开发板 + 未来眼镜形态\"的口径'\n    '呈现，不将开发板等同于最终产品。'\n)\n\nadd_callout(\n    '据本项目的移植记录，这是 OpenVela（Vela）系统首次完整部署到 BK7258 这颗芯片'\n    '上：仓库中 BK7258 的芯片级支持代码（启动流程、寄存器操作、链接脚本等）为从零'\n    '搭建，仅在目录组织方式上参考了同厂商 BK7236N 芯片的既有实现，寄存器读写、启动'\n    '代码、镜像打包工具均未直接复用现成支持包。这一表述基于代码仓库可查的移植过程，'\n    '是\"据我们的移植记录\"的限定表述，不构成对行业内是否存在其他团队完成过同类移植'\n    '的判断。'\n)\n\nDOC.add_paragraph('本报告聚焦两个已经完整跑通、可现场演示的核心功能：')\n\nadd_table(\n    ['核心功能', '当前状态', '演示形式'],\n    [\n        ['一、闲时语音助手（拍照/文字问 AI）', '完整闭环，已实测可用', '按键触发，现场问答'],\n        ['二、社交情绪识别（左屏情绪光环）', '功能完整，UI 视觉效果未曾上屏验证过', '需提前用真机预演一次确认效果'],\n    ],\n    widths=[8, 5, 5],\n)\n\nDOC.add_paragraph(\n    '除以上两个功能外，项目在摄像头硬件编码、音频驱动、Wi-Fi 组网、存储读写和网页'\n    '调试控制台等方面也已完成基础能力建设，这些属于支撑两个核心功能运行的底层工作，'\n    '本报告不逐项展开，仅在需要处简要提及。'\n)\n\nadd_callout(\n    '⚠️ 重要提示：社交情绪识别的\"左屏情绪光环\"UI 效果在提交记录中被开发者本人标注为'\n    '\"尚未在真机屏幕上看过效果\"。正式演示或录制视频前，必须先在真机上完整跑一遍，'\n    '确认视觉效果符合预期，避免现场或录制时出现意外。'\n)\n\n# ======================================================================\n# 二、核心功能一：闲时语音助手\n# ======================================================================\nDOC.add_heading('二、核心功能一：闲时语音助手（AI 问答闭环）', level=1)\n\nDOC.add_heading('2.1 交互流程', level=2)\nDOC.add_paragraph(\n    '用户在历史记录页或空白页短按电源键触发一轮对话。系统按以下顺序执行，'\n    '每个阶段都能被用户按键中途取消，取消响应时间控制在 500 毫秒以内：'\n)\nfor i, step in enumerate([\n    '（可选）拍摄一张照片，用于视觉问答',\n    '开始录音，实时流式上传给语音识别服务',\n    '语音转文字完成后，连同上下文交给大语言模型',\n    '模型返回 JSON 格式的答案（含屏幕摘要、完整语音稿、是否需要播报）',\n    '屏幕显示摘要文字，同时流式语音播报完整答案',\n    '本轮对话写入历史记录，可继续追问（最多 20 轮）',\n], 1):\n    DOC.add_paragraph(f'{i}. {step}', style='List Number')\n\nDOC.add_heading('2.2 云端服务提供商', level=2)\nadd_table(\n    ['能力', '服务商', '说明'],\n    [\n        ['语音识别 ASR', '火山引擎（字节跳动）', '流式识别，边说边传'],\n        ['语音合成 TTS', '火山引擎（字节跳动）', '流式播报，可随时打断'],\n        ['文本/视觉大模型', '小米 MiMo', '固定使用 mimo-v2.5 模型（旧预设已于\\n2026-06-30 下线，不可再用）'],\n    ],\n)\n\nDOC.add_heading('2.3 实测数据', level=2)\nadd_table(\n    ['指标', '实测数值', '备注'],\n    [\n        ['文本问答往返延迟', '约 5.1 秒', '含云端模型推理时间'],\n        ['视觉问答（480×480 照片）', '14.4～14.8 秒', '含图片编码、上传、模型推理'],\n        ['视觉问答（240×240 照片）', '3.6 秒', '准确率与大图一致，速度快 4 倍'],\n        ['拍照耗时', '约 313 毫秒', '拷贝 27ms + 硬件编码 286ms'],\n        ['麦克风到\"可以说话\"响应', '9 毫秒', '此前被误以为的\"2-3 秒延迟\"\\n实际在网络握手阶段'],\n        ['按键到进入聆听状态', '651ms → 486ms', '优化后提速约 25%'],\n    ],\n)\n\nadd_callout(\n    '一个值得讲的工程故事：团队最初怀疑麦克风启动慢，加了打点后发现麦克风只需 9 毫秒，'\n    '真正的延迟藏在网络握手和 DNS 查询里。后续优化中有一次性能预测被实测证伪，'\n    '工程师主动在下一条提交里公开纠正——这类\"先假设、再用数据推翻假设\"的过程，'\n    '是展示工程严谨性很好的素材。'\n)\n\nDOC.add_heading('2.4 已知限制', level=2)\nDOC.add_paragraph(\n    '• 当前没有接入\"查心率\"\"震动反馈\"等设备控制类工具，AI 只能对话和回答问题，'\n    '不能主动操控设备其他功能，演示话术需避免暗示\"AI 能控制设备其他能力\"。\\n'\n    '• TTS 播报偶发卡顿，云端服务经排查确认完全健康（送达速率是实时语速的 5.7～8.5 倍），'\n    '此前怀疑的\"数据量过大\"也已被证伪（换用更小的 MP3 格式后卡顿依然存在），'\n    '真正根因仍在排查中，对外表述应为\"部分优化，非完全解决\"。'\n)\n\n# ======================================================================\n# 三、核心功能二：社交情绪识别\n# ======================================================================\nDOC.add_heading('三、核心功能二：社交情绪识别', level=1)\n\nDOC.add_paragraph(\n    '用户在历史页长按电源键进入社交模式：设备持续采集画面与声音并上传自建云端'\n    '（与语音助手用的服务商完全不同的独立后端）识别对方情绪，左侧屏幕实时'\n    '显示一个颜色随情绪变化的光环，长按返回键结束会话，设备用语音播报一段情绪小结。'\n)\n\nDOC.add_heading('3.1 近期修复的三个关键问题', level=2)\nadd_table(\n    ['问题', '修复前', '修复后'],\n    [\n        ['存储写入速度', '1.8 KB/秒', '8.4 KB/秒'],\n        ['音频丢弃率', '44.8%', '接近 0'],\n        ['结束流程反馈', '70 秒无任何提示，像卡死', '拆成 5 个阶段实时汇报进度'],\n    ],\n)\n\nDOC.add_heading('3.2 极端情绪路径', level=2)\nDOC.add_paragraph(\n    '这是社交模式下的一个特殊分支：当识别到强烈情绪信号时触发额外提醒。排查历史'\n    '记录显示，此前该功能几乎从未真实触发过——置信度门槛设为 60 分，但云端模型'\n    '实际只产出 37～67 分区间的数值，绝大多数正常场景直接被门槛挡在外面；同时还'\n    '有世代号计数逻辑写反、结果被重复计数 50 次等连环问题。目前门槛已下调，但'\n    '演示前务必用真机实际触发一次，确认能正常工作。'\n)\n\nadd_callout(\n    '⚠️ 情绪光环这块 UI 在开发提交记录里被作者标注为\"尚未在真机屏幕上验证过\"，'\n    '这是当前全部功能里唯一一个没有确认过实际视觉效果的模块，演示前必须真机预演。'\n)\n\n# ======================================================================\n# 四、支撑能力简述（不作为演示重点）\n# ======================================================================\nDOC.add_heading('四、支撑能力简述（不作为演示重点）', level=1)\n\nDOC.add_paragraph(\n    '以下能力是两个核心功能能够稳定运行的底层支撑，已经完成验证，但不建议作为'\n    '独立演示环节，正式演示或录制时用一句话/字幕带过即可。'\n)\n\nadd_table(\n    ['支撑能力', '简述'],\n    [\n        ['摄像头硬件编码', '硬件 JPEG 编码，640×480 可跑到约 24～29 帧/秒，用于给视觉问答\\n和社交情绪识别提供画面输入'],\n        ['音频驱动', '采样率 8/16/32kHz，麦克风增益可调，播放音量三个历史缺陷已修复'],\n        ['Wi-Fi 组网', '上行/下行吞吐经优化后达到 60～120 KB/s 区间，满足云端交互需求'],\n        ['存储读写', 'SD 存储总线时钟从约 101.6 kHz 提升到 26 MHz，历史记录读写更快'],\n        ['网页调试控制台', '开发阶段用于远程连接、看画面、执行命令的调试工具，量产后\\n不会出现在最终产品里'],\n    ],\n)\n\nDOC.add_page_break()\n\n# ======================================================================\n# 五、演示建议与风险清单\n# ======================================================================\nDOC.add_heading('五、演示建议与风险清单', level=1)\n\nDOC.add_heading('5.1 推荐演示顺序（双功能聚焦版）', level=2)\nfor i, step in enumerate([\n    '开场：说明这是 BK7258 开发板，跑的是给未来眼镜产品准备的能力，并提及'\n    '\"据移植记录，OpenVela 系统首次完整部署到 BK7258\"',\n    '一句话/字幕带过支撑能力（摄像头、联网、调试控制台），不展开演示',\n    '【核心功能一】闲时语音助手：现场拍照问 AI，AI 语音回答，可追问一轮',\n    '【核心功能二，需提前真机预演】社交情绪识别：现场展示左屏情绪光环',\n    '结尾：强调\"当前是开发板，目标是眼镜形态\"',\n], 1):\n    DOC.add_paragraph(f'{i}. {step}', style='List Number')\n\nDOC.add_heading('5.2 演示前必须确认的风险点', level=2)\nadd_table(\n    ['风险点', '原因', '建议'],\n    [\n        ['情绪光环 UI 效果', '开发记录显示从未在真机屏幕上验证过实际效果', '正式演示前至少完整预演一次'],\n        ['极端情绪路径触发', '此前因门槛设置过高几乎从未真实触发过', '演示前用真机实际测试确认能触发'],\n        ['TTS 播报偶发卡顿', '根因尚未定位，非完全解决', '避免长文本播报，或提前录屏备份'],\n        ['\"开发板 vs 眼镜\"表述', '现场展示的是开发板本体，非成品外形', '口播和字幕都要明确说明当前形态与目标形态的区别'],\n        ['\"首次部署\"措辞', '仅有本项目移植记录为依据，无法验证行业范围内是否有先例', '使用\"据我们的移植记录\"限定表述，不说\"全球/业界首次\"'],\n    ],\n)\n\nadd_callout(\n    '本报告所有数据均来自代码仓库的真实提交记录与实测日志，未包含任何未经验证的推测性内容。'\n    '若某项功能在正式演示当天出现与本报告不一致的现象，应优先信任现场实测结果。'\n)\n\nOUT = '/home/mi/vela_competition_continue/VelaSight_功能展示报告.docx'\nDOC.save(OUT)\nprint('saved:', OUT)\n"}, "output": null}
